# Copy to server/.env for local development. Never commit the real .env.

# "production" on Render; leave unset locally
NODE_ENV=

PORT=3001

# Neon Postgres connection string (Neon dashboard > Connect). Use the pooled
# connection string and keep ?sslmode=require on the end.
# Use a separate Neon branch (e.g. "dev") locally so testing never touches production data.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Optional locally (a dev-only default is used), required in production.
JWT_SECRET=

# Encrypts authenticator-app (2FA) secrets in the database. Long and random,
# different from JWT_SECRET; generate the same way. Optional locally, required
# in production. Changing it later switches off everyone's existing 2FA.
TOTP_ENCRYPTION_KEY=

# Public URL of the frontend, used in email links
APP_URL=http://localhost:5173

# Comma-separated origins allowed to call the API directly
CORS_ORIGINS=http://localhost:5173

# Brevo transactional email (HTTPS API). Leave blank locally to print emails
# to the server console instead. Required in production.
BREVO_API_KEY=
# Must be a sender address verified in your Brevo account
EMAIL_FROM=
EMAIL_FROM_NAME=Rhabit

# Local testing only: 30-second task windows and penalties, confirm unlocks
# after 10 seconds. Ignored when NODE_ENV=production.
TEST_TIMERS=
