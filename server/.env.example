# Copy to server/.env for local development. Never commit the real .env.

# "production" on Render; leave unset locally
NODE_ENV=

PORT=3001

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Optional locally (a dev-only default is used), required in production.
JWT_SECRET=

# Public URL of the frontend, used in email links
APP_URL=http://localhost:5173

# Comma-separated origins allowed to call the API directly
CORS_ORIGINS=http://localhost:5173

# Brevo transactional email (HTTPS API). Leave blank locally to print emails
# to the server console instead. Required in production.
BREVO_API_KEY=
# Must be a sender address verified in your Brevo account
EMAIL_FROM=
EMAIL_FROM_NAME=Rhabit
